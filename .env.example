# Django
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8003

# PostgreSQL (used by docker-compose and supported directly by Django settings)
POSTGRES_DB=fitai
POSTGRES_USER=fitai
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Optional alternative. When set, DATABASE_URL takes precedence.
# DATABASE_URL=postgresql://fitai:password@db:5432/fitai
